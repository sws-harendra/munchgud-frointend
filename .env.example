# ==============================================================================
# MUNCHGUD FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local overrides

NODE_ENV=development
PORT=3000

# Backend API URL (for browser client-side requests)
NEXT_PUBLIC_serverurl=http://localhost:8008

# Backend internal Docker URL (for Next.js SSR requests when running in Docker)
INTERNAL_SERVER_URL=http://backend:8008

# Frontend URL
CLIENT_URL=http://localhost:3000
